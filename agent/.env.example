# 复制为 .env 后填写。.env 已被 .gitignore 忽略,不得提交到 GitHub。

# ---- ima 共享知识库(手册第五、六节)----
# 用已加入共享知识库的同一 ima 账号登录 https://ima.qq.com/agent-interface 获取
IMA_OPENAPI_CLIENTID=
IMA_OPENAPI_APIKEY=
IMA_KB_NAME=任德耀新建华为PC知识库

# ---- 大模型(通用 OpenAI 兼容接口,手册未指定模型)----
# 请求地址填到 /v1 为止,例如 https://api.deepseek.com/v1 或 https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 可选:备用模型,主模型超时或报错时自动切换,避免现场中断
LLM_FALLBACK_MODEL=
# 可选：独立备用服务地址和密钥；留空则复用主服务
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
# chat 或 responses；Codex内层驱动需要responses
LLM_WIRE_API=chat
# http 或 codex。演示模式由网页主动选择，不随缺凭证自动启用
LLM_MODE=http
CODEX_BIN=codex
LLM_TIMEOUT_MS=45000
PORT=3000
