{
  "type": "object",
  "properties": {
    "stage": {
      "const": "compliance_review"
    },
    "schema_version": {
      "const": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "_common.json#/$defs/Finding"
      },
      "minItems": 0
    },
    "degraded": {
      "oneOf": [
        {
          "$ref": "_common.json#/$defs/Degraded"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "stage",
    "schema_version",
    "findings",
    "degraded"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "compliance_review.json"
}
