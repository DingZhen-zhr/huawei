                "minItems": 0
              },
              "checkpoint": {
                "type": "string"
              },
              "pitfall": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "seq",
              "action",
              "say",
              "highlight_fact_ids",
              "checkpoint",
              "pitfall"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "objection_handling": {
          "type": "array",
