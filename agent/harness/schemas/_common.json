      "required": [
        "id",
        "record_id",
        "model_name",
        "sku_text",
        "price_type",
        "amount",
        "ref_amount",
        "conditions",
        "stock_text",
        "region_text",
        "verified_at",
        "doc_title",
        "doc_path",
        "origin",
        "official_url"
      ],
      "additionalProperties": false
    },
    "Quote": {
      "type": "object",
      "properties": {
        "model_name": {
          "type": "string"
        },
        "sku_text": {
          "type": "string"
        },
        "unit_price": {
          "type": "number"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "subtotal": {
          "type": "number"
        },
        "formula": {
          "type": "string"
        },
        "price_type": {
          "type": "string"
        },
        "verified_at": {
          "type": "string"
        },
        "channel": {
          "type": "string"
        },
        "region_text": {
          "type": "string"
        },
        "official_url": {
          "type": "string"
        },
        "doc_title": {
          "type": "string"
        },
        "record_id": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        }
      },
      "required": [
        "model_name",
        "sku_text",
        "unit_price",
        "quantity",
        "subtotal",
        "formula",
        "price_type",
        "verified_at",
        "channel",
        "region_text",
        "official_url",
        "doc_title",
        "record_id",
        "notes"
      ],
      "additionalProperties": false
    },
    "Model": {
      "type": "object",
      "properties": {
        "model_id": {
          "type": "string"
        },
        "model_name": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "primary",
            "candidate",
            "recommended"
          ]
        },
        "why": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "model_id",
        "model_name",
        "role",
        "why"
      ],
      "additionalProperties": false
    },
    "Conflict": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "model_id": {
          "type": "string"
        },
        "topic": {
          "$ref": "_common.json#/$defs/FactTopic"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fact_id": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "doc_title": {
                "type": "string"
              }
            },
            "required": [
              "fact_id",
              "value",
              "doc_title"
            ],
            "additionalProperties": false
          },
          "minItems": 2
        },
        "resolved": {
          "const": false
        }
      },
      "required": [
        "id",
        "model_id",
        "topic",
        "values",
        "resolved"
      ],
      "additionalProperties": false
    },
    "Segment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "lead",
            "body",
            "cta",
            "caption",
            "slogan",
            "subtitle",
            "selling_point",
            "event_note"
          ]
        },
        "heading": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": "string"
        },
        "fact_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "image_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "is_fact_claim": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "role",
        "heading",
        "text",
        "fact_ids",
        "image_ids",
        "is_fact_claim"
      ],
      "additionalProperties": false
    },
    "Poster": {
      "type": "object",
      "properties": {
        "main_title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "fact_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 0
              }
            },
            "required": [
              "text",
              "fact_ids"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 3
        },
        "event_note": {
          "type": "string"
        },
        "qr_hint": {
          "type": "string"
        }
      },
      "required": [
        "main_title",
        "subtitle",
        "points",
        "event_note",
        "qr_hint"
      ],
      "additionalProperties": false
    },
    "Article": {
      "type": "object",
      "properties": {
        "title_options": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "title": {
          "type": "string"
        },
        "lead": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "_common.json#/$defs/Segment"
          },
          "minItems": 0
        },
        "cta": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "consult",
                "visit",
                "comment",
                "dm",
                "scan"
              ]
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "poster": {
          "oneOf": [
            {
              "$ref": "_common.json#/$defs/Poster"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "title_options",
        "title",
        "lead",
        "segments",
        "cta",
        "tags",
        "poster"
      ],
      "additionalProperties": false
    },
    "ImagePlan": {
      "type": "object",
      "properties": {
        "image_id": {
          "type": "string"
        },
        "insert_after": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "cover",
            "scene",
            "detail",
            "evidence",
            "cta"
          ]
        },
        "caption": {
          "type": "string"
        },
        "on_image_text": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "image_id",
        "insert_after",
        "role",
        "caption",
        "on_image_text"
      ],
      "additionalProperties": false
    },
    "QuoteBlock": {
      "type": "object",
      "properties": {
        "quote_id": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "quote_ref": {
                "type": "string"
              },
              "fact_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 0
              }
            },
            "required": [
              "text",
              "quote_ref",
              "fact_ids"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "footnote": {
          "type": "string"
        },
        "pending_notes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        }
      },
      "required": [
        "quote_id",
        "lines",
        "footnote",
        "pending_notes"
      ],
      "additionalProperties": false
    },
    "DemoScript": {
      "type": "object",
      "properties": {
        "goal": {
          "type": "string"
        },
        "duration_min": {
          "type": "integer",
          "minimum": 0
        },
        "prep": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "seq": {
