{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "_common.json",
  "$defs": {
    "Platform": {
      "type": "string",
      "enum": [
        "wechat_mp",
        "xiaohongshu",
        "moments",
        "poster"
      ]
    },
    "SceneId": {
      "type": "string",
      "enum": [
        "back_to_school",
        "business_office",
        "content_creation",
        "home_upgrade",
        "enterprise_procurement",
        "store_visit",
        "new_launch",
        "festival"
      ]
    },
    "Stage": {
      "type": "string",
      "enum": [
        "task",
        "insight",
        "strategy",
        "retrieval",
        "draft",
        "verification",
        "compliance",
        "export"
      ]
    },
    "FactTopic": {
      "type": "string",
      "enum": [
        "identity",
        "os",
        "weight",
        "thickness",
        "dimensions",
        "display_size",
        "display_type",
        "resolution",
        "refresh",
        "brightness",
        "color_gamut",
        "processor",
        "memory",
        "storage",
        "battery",
        "charging",
        "ports",
        "keyboard",
        "camera",
        "audio",
        "wireless",
        "apps_collab",
        "accessories",
        "package",
        "privacy",
        "pen",
        "limitation"
      ]
    },
    "Category": {
      "type": "string",
      "enum": [
        "absolute",
        "false_promise",
        "price_misleading",
        "ungrounded_comparison",
        "competitor_disparage"
      ]
    },
    "Degraded": {
      "type": "object",
      "properties": {
        "stage": {
          "type": "string",
          "enum": [
            "task",
            "insight",
            "strategy",
            "retrieval",
            "draft",
            "verification",
            "compliance",
            "export"
          ]
        },
        "reason": {
          "type": "string",
          "enum": [
            "llm_failed",
            "schema_invalid",
            "timeout",
            "no_data",
            "fallback_model",
            "mirror",
            "mock",
            "conflict"
          ]
        },
        "detail": {
          "type": "string"
        },
        "fallback": {
          "type": "string"
        }
      },
      "required": [
        "stage",
        "reason",
        "detail",
        "fallback"
      ],
      "additionalProperties": false
    },
    "Pending": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "topic": {
          "type": "string",
          "enum": [
            "price",
            "subsidy",
            "trade_in",
            "installment",
            "stock",
            "gift",
            "rebate",
            "policy",
            "spec",
            "image",
            "model",
            "other"
          ]
        },
        "text": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "enum": [
            "no_evidence",
            "conflict",
            "user_request_rejected",
            "out_of_kb",
            "image_missing"
          ]
        },
        "next_owner": {
          "type": "string",
          "enum": [
            "store_manager",
            "authorized_channel",
            "content_reviewer",
            "user"
          ]
        },
        "source_stage": {
          "type": "string",
          "enum": [
            "task",
            "insight",
            "strategy",
            "retrieval",
            "draft",
            "verification",
            "compliance",
            "export"
          ]
        }
      },
      "required": [
        "id",
        "topic",
        "text",
        "reason",
        "next_owner",
        "source_stage"
      ],
      "additionalProperties": false
    },
    "Fact": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "model_id": {
          "type": "string"
        },
        "model_name": {
          "type": "string"
        },
        "topic": {
          "$ref": "_common.json#/$defs/FactTopic"
        },
        "text": {
          "type": "string"
        },
        "qualifier": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "doc_title": {
          "type": "string"
        },
        "doc_path": {
          "type": "string"
        },
        "media_id": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "type": "string",
          "enum": [
            "ima",
            "local_mirror"
          ]
        },
        "verified_on": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "conflict_with": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "model_id",
        "model_name",
        "topic",
        "text",
        "qualifier",
        "doc_title",
        "doc_path",
        "media_id",
        "origin",
        "verified_on",
        "conflict_with"
      ],
      "additionalProperties": false
    },
    "ImageRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "file_name": {
          "type": "string"
        },
        "model_id": {
          "type": "string"
        },
        "model_name": {
          "type": "string"
        },
        "doc_title": {
          "type": "string"
        },
        "doc_path": {
          "type": "string"
        },
        "media_id": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "type": "string",
          "enum": [
            "ima",
            "local_mirror"
          ]
        },
        "caption_src": {
          "type": "string"
        },
        "width": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "height": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "suggested_use": {
          "type": "string"
        },
        "source_page_url": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "file_name",
        "model_id",
        "model_name",
        "doc_title",
        "doc_path",
        "media_id",
        "origin",
        "caption_src",
        "width",
        "height",
        "suggested_use",
        "source_page_url"
      ],
      "additionalProperties": false
    },
    "PriceRecord": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "record_id": {
          "type": "string"
        },
        "model_name": {
          "type": "string"
        },
        "sku_text": {
          "type": "string"
        },
        "price_type": {
          "type": "string"
        },
        "amount": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "ref_amount": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "conditions": {
          "type": "string"
        },
        "stock_text": {
          "type": "string"
        },
        "region_text": {
          "type": "string"
        },
        "verified_at": {
          "type": "string"
        },
        "doc_title": {
          "type": "string"
        },
        "doc_path": {
          "type": "string"
        },
        "origin": {
          "type": "string",
          "enum": [
            "ima",
            "local_mirror"
          ]
        },
        "official_url": {
          "type": "string"
        }
