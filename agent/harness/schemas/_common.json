        "action": {
          "type": "string"
        },
        "when": {
          "type": "string"
        },
        "script": {
          "type": "string"
        },
        "owner": {
          "type": "string",
          "enum": [
            "sales",
            "store_manager",
            "customer"
          ]
        },
        "depends_on_pending": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "seq",
        "action",
        "when",
        "script",
        "owner",
        "depends_on_pending"
      ],
      "additionalProperties": false
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "claim_ref": {
          "type": "string"
        },
        "basis": {
          "type": "string",
          "enum": [
            "user_input",
            "scene_rule",
            "inference"
          ]
        },
        "quote": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "rule_id": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "claim_ref",
        "basis",
        "quote",
        "rule_id"
      ],
      "additionalProperties": false
    },
    "Insight": {
      "type": "object",
      "properties": {
        "stage": {
          "const": "insight"
        },
        "schema_version": {
          "const": 1
        },
        "persona": {
          "type": "string"
        },
        "usage_scene": {
          "type": "string"
        },
        "purchase_stage": {
          "type": "string",
          "enum": [
            "awareness",
            "consideration",
            "comparison",
            "decision",
            "post_purchase"
          ]
        },
        "core_situation": {
          "type": "string"
        },
        "concerns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "empathy_anchors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "detail_tags": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "text",
              "detail_tags"
