            "type": "object",
            "properties": {
              "objection": {
                "type": "string"
              },
              "reply": {
                "type": "string"
              },
              "fact_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 0
              }
            },
            "required": [
              "objection",
              "reply",
              "fact_ids"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "goal",
        "duration_min",
        "prep",
        "steps",
        "objection_handling"
      ],
      "additionalProperties": false
    },
