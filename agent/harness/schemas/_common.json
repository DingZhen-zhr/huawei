        "evidence": {
          "type": "array",
          "items": {
            "$ref": "_common.json#/$defs/Evidence"
          },
          "minItems": 1
        },
        "content_goal": {
          "type": "string",
          "enum": [
            "inquiry",
            "visit",
            "compare",
            "decide",
            "refer"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "model",
            "rule_default"
          ]
        },
        "degraded": {
          "oneOf": [
            {
              "$ref": "_common.json#/$defs/Degraded"
            },
            {
              "type": "null"
            }
          ]
        }
      },
