{
  "type": "object",
  "properties": {
    "stage": {
      "const": "verification"
    },
    "schema_version": {
      "const": 1
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "_common.json#/$defs/FactCheck"
      },
      "minItems": 0
    },
    "images": {
      "type": "array",
      "items": {
        "$ref": "_common.json#/$defs/ImageCheck"
      },
      "minItems": 0
    },
    "prices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "quote_ref": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "match",
              "mismatch",
              "no_evidence",
              "rejected"
            ]
          },
          "recomputed": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "formula": {
                    "type": "string"
                  },
                  "result": {
                    "type": "number"
                  }
                },
                "required": [
                  "formula",
                  "result"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "quote_ref",
          "status",
          "recomputed",
          "note"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "removed_segments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "segment_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "segment_id",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "pending": {
      "type": "array",
      "items": {
        "$ref": "_common.json#/$defs/Pending"
      },
      "minItems": 0
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "_common.json#/$defs/Conflict"
      },
      "minItems": 0
    },
    "final_article": {
      "$ref": "_common.json#/$defs/Article"
    },
    "final_image_plan": {
      "type": "array",
      "items": {
        "$ref": "_common.json#/$defs/ImagePlan"
      },
      "minItems": 0
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "pass_with_pending",
        "blocked"
      ]
    },
    "blocked_reason": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "conflict",
            "all_facts_removed",
            "model_mismatch"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "stats": {
      "type": "object",
      "properties": {
        "claims_total": {
          "type": "integer",
          "minimum": 0
        },
        "supported": {
          "type": "integer",
          "minimum": 0
        },
        "unsupported": {
          "type": "integer",
          "minimum": 0
        },
        "removed": {
          "type": "integer",
          "minimum": 0
        },
        "pending": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "claims_total",
        "supported",
        "unsupported",
        "removed",
        "pending"
      ],
      "additionalProperties": false
    },
    "degraded": {
      "oneOf": [
        {
          "$ref": "_common.json#/$defs/Degraded"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "stage",
    "schema_version",
    "facts",
    "images",
    "prices",
    "removed_segments",
    "pending",
    "conflicts",
    "final_article",
    "final_image_plan",
    "verdict",
    "blocked_reason",
    "stats",
    "degraded"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verification.json"
}
