{
  "platform": "video",
  "label": "视频号",
  "capability": "MANUAL",
  "capabilityNote": "无开放发布接口；导出 45–60 秒口播脚本与分镜，人工拍摄",
  "limits": {
    "titleMin": 6,
    "titleMax": 12,
    "bodyMin": 100,
    "bodyMax": 1600,
    "tagsMin": 0,
    "tagsMax": 0,
    "paragraphMaxLines": 5,
    "images": {
      "min": 1,
      "max": 1,
      "ratio": "9:16",
      "minWidth": 1080
    }
  },
  "banned": [
    "最好",
    "最佳",
    "最强",
    "最低价",
    "最高级",
    "国家级",
    "顶级",
    "绝对",
    "100%",
    "全网最低",
    "史无前例",
    "永久",
    "包治",
    "第一品牌",
    "行业第一",
    "排名第一",
    "销量第一"
  ],
  "bannedReason": "极限词/绝对化用语，违反《广告法》第九条",
  "falsePositiveGuards": [
    {
      "word": "100%",
      "allowSuffixes": [
        "sRGB",
        "Adobe RGB",
        "DCI-P3",
        "NTSC"
      ],
      "reason": "色域参数属客观规格，不构成绝对化用语"
    },
    {
      "word": "第一",
      "allowSuffixes": [
        "：",
        "、",
        "，",
        ",",
        "步",
        "点",
        "次",
        "件",
        "个",
        "部分",
        "时间",
        "条",
        "句",
        "段",
        "张",
        "台",
        "款",
        "种",
        "轮",
        "遍",
        "层",
        "块",
        "套",
        "道",
        "关",
        "名",
        "位"
      ],
      "reason": "序数用法，不是绝对化排名"
    },
    {
      "word": "最好",
      "allowSuffixes": [
        "先",
        "还是",
        "别",
        "能",
        "在",
        "提前",
        "把",
        "用",
        "去",
        "问",
        "试",
        "看"
      ],
      "reason": "建议用法，不是绝对化比较"
    }
  ],
  "required": [
    {
      "key": "DURATION",
      "label": "口播时长",
      "hint": "45–60 秒，首 3 秒给钩子"
    }
  ],
  "style": {
    "tone": "口语、节奏快、像门店同事讲话",
    "emojiPer100": 0.5,
    "hashtagStyle": "",
    "titlePattern": "首 3 秒钩子"
  },
  "checklist": [
    "首 3 秒是否有钩子",
    "是否有 3–5 个分镜",
    "事实、条件、限制是否出现在脚本里",
    "结尾是否自然引导到店或私聊"
  ]
}