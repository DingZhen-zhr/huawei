    {
      "word": "第一",
      "allowSuffixes": [
        "：",
        "、",
        "，",
        ",",
        "步",
        "点",
        "次",
        "件",
        "个",
        "部分",
        "时间",
        "条",
        "句",
        "段",
        "张",
        "台",
        "款",
        "种",
        "轮",
        "遍",
        "层",
        "块",
        "套",
        "道",
        "关",
        "名",
        "位"
      ],
      "reason": "序数用法，不是绝对化排名"
    },
    {
      "word": "最好",
      "allowSuffixes": [
        "先",
        "还是",
        "别",
        "能",
        "在",
        "提前",
        "把",
        "用",
        "去",
        "问",
        "试",
        "看"
      ],
      "reason": "建议用法，不是绝对化比较"
