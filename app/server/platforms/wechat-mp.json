{
  "platform": "wechat-mp",
  "label": "微信公众号",
  "capability": "DRAFT_ONLY",
  "capabilityNote": "官方 API 可写草稿箱并发布，但需已认证账号与 IP 白名单；演示环境不真实调用",
  "limits": {
    "titleMin": 8,
    "titleMax": 64,
    "bodyMin": 800,
    "bodyMax": 3000,
    "tagsMin": 0,
    "tagsMax": 0,
    "paragraphMaxLines": 5,
    "images": {
      "min": 1,
      "max": 20,
      "ratio": "16:9",
      "coverSize": "900x383"
    }
  },
  "banned": [
    "最佳",
    "最强",
    "最低价",
    "最高级",
    "国家级",
    "顶级",
    "绝对",
    "100%",
    "全网最低",
    "史无前例",
    "永久",
    "包治",
    "第一品牌",
    "行业第一",
    "排名第一",
    "销量第一",
    "最好的",
    "最好用"
  ],
  "bannedReason": "极限词/绝对化用语，违反《广告法》第九条",
  "falsePositiveGuards": [
    {
      "word": "100%",
      "allowSuffixes": [
        "sRGB",
        "Adobe RGB",
        "DCI-P3",
        "NTSC"
      ],
      "reason": "色域参数属客观规格，不构成绝对化用语"
    },
    {
      "word": "第一",
      "allowSuffixes": [
        "：",
        "、",
        "，",
        ",",
        "步",
        "点",
        "次",
        "件",
        "个",
        "部分",
        "时间",
        "条",
        "句",
        "段",
        "张",
        "台",
        "款",
        "种",
        "轮",
        "遍",
        "层",
        "块",
        "套",
        "道",
        "关",
        "名",
        "位"
      ],
      "reason": "序数用法，不是绝对化排名"
    },
    {
      "word": "最好",
      "allowSuffixes": [
        "先",
        "还是",
        "别",
        "能",
        "在",
        "提前",
        "把",
        "用",
        "去",
        "问",
        "试",
        "看"
      ],
      "reason": "建议用法，不是绝对化比较"
    }
  ],
  "required": [
    {
      "key": "SOURCE_NOTE",
      "label": "信息来源标注",
      "hint": "文末注明『信息基准日 2026-10-17，以门店实际报价为准』"
    }
  ],
  "style": {
    "tone": "专业、克制",
    "emojiPer100": 0.3,
    "hashtagStyle": "",
    "titlePattern": "结论前置"
  },
  "checklist": [
    "首图是否 900x383",
    "摘要是否 ≤120 字",
    "价格是否带『以门店实际报价为准』"
  ]
}