# DeepSeek API 配置（复制为 .env 并填入真实值，勿提交 .env）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 服务端端口
PORT=8787

# 本地 embedding 镜像（国内网络用 hf-mirror）
HF_ENDPOINT=https://hf-mirror.com

# 门店会话与后台（生产环境必须显式配置）
# HC_SESSION_SECRET 至少 32 字符；不要使用示例值
HC_SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_PASSCODE=replace-with-a-strong-admin-passcode
# 生产环境保持 false，演示环境可设为 true
HC_DEMO_MODE=false
DEMO_STORE_CODE=HUAWEI-001
DEMO_STORE_PIN=246810
