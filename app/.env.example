# DeepSeek API 配置（复制为 .env 并填入真实值，勿提交 .env）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 服务端端口
PORT=8787

# 门店会话与后台（生产环境必须显式配置）
# HC_SESSION_SECRET 至少 32 字符；不要使用示例值
HC_SESSION_SECRET=
ADMIN_PASSCODE=
# 本地演示设 true；生产设 false（关闭演示入口）
HC_DEMO_MODE=true
DEMO_STORE_CODE=HUAWEI-001
DEMO_STORE_PIN=246810

# 数据持久化：supabase（后端写 Supabase）或 local（JSON 运行时，测试用）
HC_PERSISTENCE=supabase

# Supabase：不填则自动回退本地 JSON。POOLER 用于应用（6543），DB_URL 用于迁移（5432）。
SUPABASE_POOLER_URL=
SUPABASE_DB_URL=

# 内容生成模式：model（默认，走 DeepSeek）或 rules（强制规则稿）
HC_GENERATION=model
# 内容模型（默认继承 DEEPSEEK_MODEL）
DEEPSEEK_CONTENT_MODEL=deepseek-chat
# 单渠道失败后是否允许自动修复一次被核验拦下的版本（Serverless 默认关闭）
HC_MODEL_REPAIR=false

# Tavily：按需搜索华为官方来源（可选；不配则跳过搜索）
TAVILY_API_KEY=
